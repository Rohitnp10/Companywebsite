<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep Laravel internals off the web when the project root is public_html.
    RewriteRule ^(?:\.env|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|node_modules)(/|$) - [F,L]

    # Send every public request into Laravel's front controller directory.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
